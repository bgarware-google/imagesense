# Google Cloud Project Configuration for Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Search (Discovery Engine) Configuration (Optional)
# VERTEX_SEARCH_DATASTORE_ID=imagesense-datastore
# DISCOVERY_ENGINE_LOCATION=global

# Optional: Path to Service Account credentials JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Local Gradio Server Configuration
PORT=8080
GRADIO_SHARE=false
