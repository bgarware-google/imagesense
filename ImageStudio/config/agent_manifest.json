{
  "version": "1.2.0",
  "active_topology": "multi_agent_collaborative_v1",
  "experiments": {
    "current_experiment_id": "exp_v12_retrieval_augmented_editing",
    "enabled": true,
    "traffic_split": {
      "variant_a_control": 50,
      "variant_b_candidate": 50
    },
    "variants": {
      "variant_a_control": {
        "description": "Baseline Imagen 4 generation from scratch",
        "primary_model": "imagen-4.0-generate-001",
        "use_retrieval_cache": false,
        "temperature": 0.0
      },
      "variant_b_candidate": {
        "description": "Candidate Multimodal Retrieval & Delta Editing via Gemini 2.5 Flash Image",
        "primary_model": "gemini-2.5-flash-image",
        "use_retrieval_cache": true,
        "similarity_threshold": 0.70,
        "temperature": 0.2
      }
    }
  },
  "agents": {
    "guard_agent": {
      "name": "CloudArmorPromptGuardAgent",
      "version": "1.1.0",
      "strict_mode": true
    },
    "pii_agent": {
      "name": "PIIScrubberAgent",
      "version": "1.0.0",
      "redaction_mask": "[REDACTED]"
    },
    "search_agent": {
      "name": "SearchRetrievalAgent",
      "version": "1.2.0",
      "embedding_model": "multimodalembedding@001",
      "similarity_threshold": 0.70
    },
    "edit_agent": {
      "name": "ImageEditingAgent",
      "version": "1.1.0",
      "model": "gemini-2.5-flash-image"
    },
    "generation_agent": {
      "name": "ImageGenerationAgent",
      "version": "1.2.0",
      "model": "imagen-4.0-generate-001"
    },
    "safety_agent": {
      "name": "CloudVisionSafetyAgent",
      "version": "1.0.0",
      "enforce_safesearch": true
    },
    "memory_agent": {
      "name": "IndexingMemoryAgent",
      "version": "1.2.0",
      "auto_index": true
    }
  },
  "prompt_templates": {
    "enhancement_system_prompt": "Expand the user input into a rich visual prompt specifying Subject, Action, Environment, Lighting, and Quality modifiers.",
    "multimodal_edit_instruction": "Edit and refine this reference image to match the new prompt while maintaining visual fidelity, perspective, and product features: {prompt}"
  }
}
